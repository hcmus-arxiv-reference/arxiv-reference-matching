  "sentence": {
    "kind": "sentence",
    "source": "body_prose_outside_math_and_atomic_elements",
    "requires_latex_tag": false,
    "boundary_candidate": ".",
    "protected_regions": ["inline_math", "block_math", "latex_commands_and_arguments", "urls", "decimal_numbers", "abbreviations"],
    "abbreviations": ["i.e.", "e.g.", "et al.", "vs.", "cf."],
    "abbreviation_match": "case_insensitive_literal",
    "pattern_engine": "python_re",
    "protected_patterns": [
      {"name": "figure_reference", "pattern": "(?i)\\bfigs?\\.(?=[\\s~]*(?:\\d|\\\\(?:ref|autoref|cref)\\b))", "note": "Bảo vệ dấu chấm trong Fig./Figs. trước số hình hoặc lệnh tham chiếu, kể cả khoảng trắng, xuống dòng, khoảng trắng không ngắt và dấu ~. Không nuốt dấu chấm kết thúc câu sau số hình."},
      {"name": "numbered_reference", "pattern": "(?i)\\b(?:eqs?|secs?|tabs?|chaps?|thms?|props?|defs?)\\.(?=[\\s~]*(?:\\d|\\\\(?:ref|eqref|autoref|cref|Cref)\\b))", "note": "Giữ dấu chấm trong viết tắt tham chiếu trước số hoặc lệnh tham chiếu; không che dấu chấm cuối câu."}
    ],
    "note": "Chỉ dấu chấm là ứng viên kết thúc câu theo đề; bảo vệ toán, URL, số và toàn bộ đối số lệnh kể cả khi bỏ wrapper định dạng. Không tự thêm etc. vào từ viết tắt vô điều kiện vì nó có thể kết thúc câu."
  },
  "heading_rules": {"parent": "nearest_preceding_heading_with_lower_level_or_document", "level_is_relative_rank": true, "starred_creates_same_kind": true, "title_argument": "required_braced_argument", "optional_short_title": "not_used_as_content", "note": "Không tạo heading giả cho cấp bị thiếu; cấp số chỉ biểu thị thứ bậc tương đối."},
